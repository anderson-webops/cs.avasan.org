server {
	listen 80;
	listen [::]:80;
	server_name cs.avasan.org;

	access_log off;
	return 301 https://cs.avasan.org$request_uri;
}

server {
	listen 443 ssl;
	listen [::]:443 ssl;
	server_name cs.avasan.org;

	# Configure the host's existing certificate paths and TLS policy here.
	ssl_certificate /path/to/fullchain.pem;
	ssl_certificate_key /path/to/privkey.pem;

	access_log off;
	client_max_body_size 80m;

	# Keep this host proxy-only. The immutable web image owns static routes,
	# strict 404 handling, release headers, redirects, and the /api boundary.
	# Do not add a host root, alias, try_files, or a second static deployment.
	location / {
		proxy_pass http://127.0.0.1:8080;
		# Pass the inner web image's branded error documents through unchanged.
		proxy_intercept_errors off;
		# Preserve the container's relative directory redirects so the outer
		# host cannot turn /admin/ into an origin-dependent absolute Location.
		proxy_redirect off;
		proxy_http_version 1.1;
		proxy_buffering off;
		proxy_request_buffering off;
		proxy_read_timeout 120s;
		proxy_send_timeout 120s;
		proxy_set_header Connection "";
		proxy_set_header Host $host;
		# Replace rather than append client-supplied forwarding headers. The
		# container proxy passes this single value to Express, which trusts one
		# known proxy hop.
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Proto https;
	}
}
