# Install as deploy/cs.env (ignored by Git) with mode 0600. Use separate,
# URL-safe random Mongo passwords because Compose places the application
# credential in MONGODB_URI. The application user has only readWrite on its
# one database. Root credentials are reserved for database initialization and
# maintenance; the web API never receives them.
MONGO_ROOT_USERNAME=cs_avasan_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=cs_avasan_app
MONGO_APP_PASSWORD=
SESSION_SECRET=
# Optional private diagnostics access. Leave blank to disable. If configured,
# use a separate random value containing at least 32 UTF-8 bytes.
INTERNAL_DIAGNOSTICS_KEY=

# Production release identity. SOURCE_REVISION is required by
# compose.production.yml and must be the full lowercase commit SHA being
# deployed. Leaving it blank makes production Compose fail before it can build.
CS_RELEASE_VERSION=2.7.100
SOURCE_REVISION=

# All student-data features fail closed. Approval and a real direct contact are
# required on both the backend and the frontend build before any feature can be
# enabled. Do not invent this contact.
CLASSROOM_PRIVACY_APPROVED=false
SCHOOL_PRIVACY_CONTACT=
# Public reviewed text. The first value must name every operator and include
# each postal address, phone number, and email. The second must name every
# approved infrastructure or identity provider, its limited purpose, and the
# student information it handles. Do not use placeholders in production.
CLASSROOM_PRIVACY_OPERATOR_NOTICE=
CLASSROOM_SERVICE_PROVIDER_NOTICE=
STUDENT_ACCOUNTS_ENABLED=false
STUDENT_OAUTH_ENABLED=false
# Required before accounts are enabled and must remain configured while any
# account records or still-available deletion receipts are retained, including
# during shutdown/maintenance. The authorized school/district reviewer must
# select a whole number from 30 through 365; there is no default.
STUDENT_RECORD_RETENTION_DAYS=
CLASSROOM_ANALYTICS_COLLECTION_ENABLED=false
CLASSROOM_ANALYTICS_RETENTION_DAYS=90

# Feature decisions are baked into the frontend image at build time.
# Production Compose maps the canonical approval, feature flags, contact,
# operator/provider notices, and retention value above into their Vite
# equivalents. Do not add separate VITE feature toggles here: a second set of
# switches could make the public controls disagree with the API.

# Optional provider credentials. Leave all blank while STUDENT_OAUTH_ENABLED is
# false. Email/profile scopes are not requested. The code exchange transiently
# processes the provider token response but does not persist provider tokens.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_BASE64=

# Optional Vault configuration. If enabled, the stored URI must authenticate as
# the same dedicated application user, never as Mongo root. Production remote
# Vault origins must use HTTPS. Any explicit Vault setup fails closed rather
# than falling back to MONGODB_URI. Redirects are refused and responses are
# bounded before parsing.
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/cs.avasan.org/mongodb
