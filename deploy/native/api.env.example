# Install as /etc/cs.avasan.org/api.env, owned by root with mode 0600.
# This file is read by both the native release builder and the systemd API
# service. Keep it valid as both a Bash environment file and a systemd
# EnvironmentFile; quote values containing spaces. Release identity and fixed
# same-origin settings are generated or enforced elsewhere.

# Use exactly one credential source. A direct URI must authenticate as the
# dedicated readWrite user for cs-avasan-org, never Mongo root. If any Vault
# AppRole setting is supplied, Vault is authoritative and failures do not fall
# back to MONGODB_URI.
MONGODB_URI=
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/cs.avasan.org/mongodb

SESSION_SECRET=
INTERNAL_DIAGNOSTICS_KEY=

# Privacy and feature decisions are canonical here. The release builder maps
# the same values into the frontend; the service preflight refuses a later
# restart if this file drifts from the built release.
CLASSROOM_PRIVACY_APPROVED=false
SCHOOL_PRIVACY_CONTACT=
# Required before any student-data feature is enabled: a reviewed safe version
# token and the policy's real, current-or-past YYYY-MM-DD effective date.
CLASSROOM_PRIVACY_POLICY_VERSION=
CLASSROOM_PRIVACY_POLICY_EFFECTIVE_DATE=
CLASSROOM_PRIVACY_OPERATOR_NOTICE=
CLASSROOM_SERVICE_PROVIDER_NOTICE=
STUDENT_ACCOUNTS_ENABLED=false
STUDENT_OAUTH_ENABLED=false
STUDENT_RECORD_RETENTION_DAYS=
CLASSROOM_ANALYTICS_COLLECTION_ENABLED=false
CLASSROOM_ANALYTICS_RETENTION_DAYS=90

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY_BASE64=

OAUTH_RATE_MAX=120
OAUTH_RATE_WINDOW_MS=900000
PYTHON_IDE_PROJECT_BODY_LIMIT=80mb
