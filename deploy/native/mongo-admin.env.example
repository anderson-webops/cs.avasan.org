# Install only when operating a self-hosted native MongoDB instance. Keep this
# separate from api.env; the web service must never receive root credentials.
# Own it as root with mode 0600 and remove it when credentials are held by the
# server's normal secret store instead.
MONGO_ROOT_USERNAME=cs_avasan_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=cs_avasan_app
MONGO_APP_PASSWORD=
