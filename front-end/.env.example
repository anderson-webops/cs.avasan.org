VITE_SITE_URL=https://cs.avasan.org
# School or district privacy contact shown on /student-privacy.
# Use the exact contact provided with student access; do not invent one.
VITE_SCHOOL_PRIVACY_CONTACT=
VITE_CLASSROOM_PRIVACY_OPERATOR_NOTICE=
VITE_CLASSROOM_SERVICE_PROVIDER_NOTICE=
# The frontend fails closed independently. Set approval, a direct contact, and
# each desired feature here only when the matching backend settings are ready.
VITE_CLASSROOM_PRIVACY_APPROVED=false
VITE_STUDENT_ACCOUNTS_ENABLED=false
VITE_STUDENT_OAUTH_ENABLED=false
# Keep this set to the approved value while retained account records or
# still-available deletion receipts require Julio's maintenance-only Admin
# tools, even when accounts are off.
VITE_STUDENT_RECORD_RETENTION_DAYS=
VITE_CLASSROOM_USAGE_ENABLED=false
