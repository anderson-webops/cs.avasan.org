# Local database and session settings
MONGODB_URI="mongodb://localhost:27017/cs-avasan-org"
SESSION_SECRET=
PORT=3008
HOST=127.0.0.1

# Optional production cookie behavior when the API is on another origin
NODE_ENV=development
CROSS_SITE=
# Set only when the API is exclusively behind that many trusted proxies. Each
# proxy must replace, not append to, the incoming X-Forwarded-For header.
TRUST_PROXY_HOPS=

# Public Python IDE asset archive from the reviewed downstream asset host.
PYTHON_IDE_ASSETS_ZIP_URL=https://static.cs.avasan.org/assets.zip

# Optional HashiCorp Vault AppRole configuration
VAULT_ADDR=http://127.0.0.1:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/cs.avasan.org/mongodb

# Required to access the internal database diagnostics endpoint in any environment
INTERNAL_DIAGNOSTICS_KEY=

# Teacher login throttling
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10
