# Local database and session settings
MONGODB_URI="mongodb://localhost:27017/cs-avasan-org"
# Production requires at least 32 UTF-8 bytes. Generate a random value with:
# openssl rand -base64 32
SESSION_SECRET=
PORT=3008
HOST=127.0.0.1

# Classroom sessions are same-origin. Local Vite runs on port 3333. Production
# safely defaults to https://cs.avasan.org when this is blank; any production
# override must be an HTTPS origin with no path.
NODE_ENV=development
CLASSROOM_ORIGIN=http://127.0.0.1:3333
CROSS_SITE=false
# Set only when the API is exclusively behind that many trusted proxies. Each
# proxy must replace, not append to, the incoming X-Forwarded-For header.
TRUST_PROXY_HOPS=

# Authenticated Python project payload limit. The 80 MB default accounts for
# worst-case JSON escaping at the 12,000,000-character project ceiling.
# Bodies above 4 MiB and bodies without a trustworthy Content-Length enter a
# separate low-frequency tier with one active body process-wide. Normal bodies
# retain a wider classroom tier: two per identity and eight process-wide.
# Compressed bodies are rejected to prevent request-inflation attacks.
PYTHON_IDE_PROJECT_BODY_LIMIT=80mb

# Optional HashiCorp Vault AppRole configuration
VAULT_ADDR=
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_MONGODB_SECRET_PATH=secret/data/cs.avasan.org/mongodb

# Required to access the internal database diagnostics endpoint in any environment
INTERNAL_DIAGNOSTICS_KEY=

# Optional student-data features fail closed independently. Enabling any of
# them requires explicit school/district approval and the real direct privacy
# contact provided with student access. Do not invent this contact.
CLASSROOM_PRIVACY_APPROVED=false
SCHOOL_PRIVACY_CONTACT=
STUDENT_ACCOUNTS_ENABLED=false
CLASSROOM_ANALYTICS_COLLECTION_ENABLED=false
# Anonymous daily counts expire after 90 days by default. A whole number from
# 7 through 90 may shorten that window.
CLASSROOM_ANALYTICS_RETENTION_DAYS=90

# Teacher login throttling
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# Student Google/Apple sign-in. Buttons stay hidden unless every required
# setting for that provider is present. Register the exact callback URLs:
# https://cs.avasan.org/api/students/oauth/google/callback
# https://cs.avasan.org/api/students/oauth/apple/callback
# Only OpenID ("openid") is requested; do not enable email, profile, name, or
# offline-access scopes.
# This also requires STUDENT_ACCOUNTS_ENABLED=true.
STUDENT_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# APPLE_OAUTH_CLIENT_ID is the web Services ID. The private key can be supplied
# as escaped PEM text or, preferably, as its base64 representation.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_PRIVATE_KEY_BASE64=

# A provider round trip uses two requests. Defaults leave room for a classroom
# sharing one public address while still bounding automated churn.
OAUTH_RATE_WINDOW_MS=900000
OAUTH_RATE_MAX=120
