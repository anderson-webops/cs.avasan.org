include=optional
strict-allow-scripts=true
allow-scripts=argon2@0.45.1,esbuild@0.28.1,fsevents@2.3.3

# This policy applies when CI validates the standalone backend lockfile with
# `--workspaces=false`. Exact approvals live here because npm ignores an
# `allowScripts` field declared by a non-root workspace during root installs.
