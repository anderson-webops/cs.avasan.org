{
	"name": "back-end",
	"version": "1.0.0",
	"private": true,
	"description": "Admin-only API for Classes with Julio",
	"type": "module",
	"main": "dist/server.js",
	"scripts": {
		"server": "tsx watch -r dotenv/config src/server.ts",
		"server:once": "tsx -r dotenv/config src/server.ts",
		"test": "vitest run",
		"start": "node dist/server.js",
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"watch": "tsc -w",
		"dev": "tsx watch -r dotenv/config src/server.ts",
		"up": "npm exec --yes -- taze major -I",
		"lint": "eslint \"src/**/*.{js,ts}\"",
		"lint-fix": "eslint \"src/**/*.{js,ts}\" --fix",
		"create-admin-ts": "tsx -r dotenv/config src/create-admin-user.ts",
		"purge-classroom-analytics-ts": "tsx -r dotenv/config src/purge-classroom-analytics.ts"
	},
	"keywords": [],
	"author": "Classes with Julio",
	"license": "ISC",
	"dependencies": {
		"argon2": "^0.45.1",
		"body-parser": "^2.3.0",
		"cookie-session": "^2.1.1",
		"dotenv": "^17.4.2",
		"esbuild": "^0.28.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.6.1",
		"helmet": "^8.3.0",
		"jose": "^6.2.4",
		"mongoose": "^9.8.1",
		"openid-client": "^6.8.4",
		"readline-sync": "^1.4.10",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@types/body-parser": "^1.19.6",
		"@types/cookie-session": "^2.0.49",
		"@types/express": "^5.0.6",
		"@types/node": "^25.6.0",
		"@types/readline-sync": "^1.4.8",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.0",
		"vitest": "^4.1.5"
	},
	"overrides": {
		"body-parser": "$body-parser",
		"brace-expansion": "5.0.8",
		"esbuild": "$esbuild",
		"js-yaml": "4.3.0",
		"postcss": "8.5.24",
		"qs": "6.15.3",
		"vite": "8.1.5"
	}
}
